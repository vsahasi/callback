# Callback detector: copy to .env and fill in. Never commit .env.

# Bearer token the LiveKit agent presents on every request.
CALLBACK_API_TOKEN=replace-me-with-a-long-random-string

# Run the scripted mock detector instead of real models.
CALLBACK_MOCK_MODE=true

# Session lifetime and OTP policy.
CALLBACK_SESSION_TTL_SECONDS=300
CALLBACK_OTP_MAX_ATTEMPTS=3
CALLBACK_OTP_TTL_SECONDS=120

# Mock-only: simulated per-request latency window, milliseconds.
CALLBACK_MOCK_JITTER_MIN_MS=150
CALLBACK_MOCK_JITTER_MAX_MS=400

# ---------------------------------------------------------- audio transport
#
# Real mode fetches each speech span from the uri on the event and measures
# it. Both of the first two are required, and the allowlist is what keeps
# POST /events from becoming a proxy into your network: the uri comes from
# the request body. An empty allowlist fetches nothing over the network, so a
# deployment that forgets it denies every call rather than opening up.
CALLBACK_AUDIO_ENABLED=false
CALLBACK_AUDIO_ALLOWED_HOSTS=
# Local development and the demo harness. Needs a root; without one a file:
# uri reads anything the process can read.
CALLBACK_AUDIO_ALLOW_FILE_URIS=false
CALLBACK_AUDIO_FILE_ROOT=
# data: uris carry the span inline, so there is no request to forge.
CALLBACK_AUDIO_ALLOW_DATA_URIS=true
# Limits. The timeout sits inside the 800 ms budget the agent allows a call.
CALLBACK_AUDIO_MAX_BYTES=8388608
CALLBACK_AUDIO_FETCH_TIMEOUT_MS=400
CALLBACK_AUDIO_MAX_SECONDS=30
