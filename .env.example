# Copy this file to .env and fill it in. .env is gitignored; never commit a value.
# The agent loads .env itself. The detector reads only its process environment, so pass its
# variables on the command line.

# ============================================================== Agent (agent/)

# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional. The name the worker registers under. Empty means "callback". The cloud backup uses "callback-cloud".
CALLBACK_AGENT_NAME=
# Optional. Any value but blank logs one line per turn and speech event the agent forwards to the
# detector: role or kind, times, word count. Never the text. Used to check the real timings.
CALLBACK_LOG_TURNS=
# The id that `lk sip outbound create` prints. The callback leg dials out through this trunk.
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=

# Agent models
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Ramp sandbox
# Optional. Empty means https://demo-api.ramp.com.
RAMP_BASE_URL=
RAMP_CLIENT_ID=
RAMP_CLIENT_SECRET=

# Telnyx
# The phone number, in E.164 form (+1...). Phone tests call it and the callback leg dials out from it.
TELNYX_NUMBER=
# The SIP credentials of the Telnyx outbound trunk. `lk sip outbound create` takes them as --auth-user and --auth-pass.
TELNYX_SIP_USER=
TELNYX_SIP_PASS=

# Attacker caller for demo call 4. Empty means TELNYX_NUMBER and CARTESIA_VOICE_ID.
ATTACK_TARGET_NUMBER=
ATTACKER_VOICE_ID=

# ============================================================== Detector (detector/)
#
# Defaults from detector/config.py are in the comments. The detector reads a blank number as its
# default, but a blank true/false as false. Delete a line you don't set to get its default.

# Run the scripted mock detector instead of real models. Default true.
CALLBACK_MOCK_MODE=

# Session lifetime and OTP policy. Defaults 300, 3 and 120.
CALLBACK_SESSION_TTL_SECONDS=
CALLBACK_OTP_MAX_ATTEMPTS=
CALLBACK_OTP_TTL_SECONDS=

# Mock-only: simulated per-request latency window, milliseconds. Defaults 150 and 400.
CALLBACK_MOCK_JITTER_MIN_MS=
CALLBACK_MOCK_JITTER_MAX_MS=

# Modulate's deepfake API. The spec lists it as a baseline to compare the detector against.
MODULATE_API_KEY=

# ------------------------------------------------------- /v1 agent contract
# The users_on_file directory the agent identifies callers against, and the number on file the
# SMS code goes to. USERS_ON_FILE_JSON (the JSON inline, which is how the Modal secret supplies
# it) wins over USERS_ON_FILE_PATH (a file). With neither, the directory is empty and every
# session create is a 404. users_on_file.example.json holds a fictional 555-01xx number; the real
# users_on_file.json is gitignored. Default: both unset.
USERS_ON_FILE_PATH=
USERS_ON_FILE_JSON=
# POST /verify/bank-details receives a full account number, so it is unmounted unless this is
# on. The agent never calls it. Blank means off.
CALLBACK_BANK_VERIFY_ENABLED=
# Mock mode accepts only the code 424242 and texts nothing. "twilio" makes mock mode send and
# check real codes through Twilio Verify, when the TWILIO_* values below are set. Default blank.
CALLBACK_MOCK_SMS=

# ---------------------------------------------------------- audio transport
#
# Real mode fetches each speech span from the uri on the event and measures
# it. Both of the first two are required, and the allowlist is what keeps
# POST /events from becoming a proxy into your network: the uri comes from
# the request body. An empty allowlist fetches nothing over the network, so a
# deployment that forgets it denies every call rather than opening up.
# Default off, with no hosts. The allowlist is comma-separated.
CALLBACK_AUDIO_ENABLED=
CALLBACK_AUDIO_ALLOWED_HOSTS=
# Local development and the demo harness. Needs a root; without one a file:
# uri reads anything the process can read. Default off, with no root.
CALLBACK_AUDIO_ALLOW_FILE_URIS=
CALLBACK_AUDIO_FILE_ROOT=
# data: uris carry the span inline, so there is no request to forge. Default true.
CALLBACK_AUDIO_ALLOW_DATA_URIS=
# Limits. The timeout sits inside the 800 ms budget the agent allows a call.
# Defaults 8388608 bytes, 400 ms and 30 seconds.
CALLBACK_AUDIO_MAX_BYTES=
CALLBACK_AUDIO_FETCH_TIMEOUT_MS=
CALLBACK_AUDIO_MAX_SECONDS=

# ---------------------------------------------------------------- enrolment
# The reference voices voice_match compares callers against (PR 3). POST /enrol/voice
# fetches a recording through the audio transport above, so enrolment is off whenever
# CALLBACK_AUDIO_ENABLED is off. Without a reference for the claimed identity, voice_match
# does not run and its weight is spread over the other signals.
# Name a modal.Dict to keep references across deploys and replicas. Empty keeps them in
# process memory, where a restart loses every enrolment.
CALLBACK_ENROLMENT_DICT_NAME=
# Ceiling on stored identities; a put past the cap is refused. Default 10000.
CALLBACK_ENROLMENT_MAX_IDENTITIES=
# Enrolment is not inside a live call, so it is not held to the call budget. Default 5000 ms.
CALLBACK_ENROLMENT_FETCH_TIMEOUT_MS=

# ============================================================== Shared (agent and detector)

# Detection service
DETECTOR_URL=
# Bearer token the LiveKit agent presents on every request, and the detector checks.
# Use a long random string. Left blank, the detector makes up its own and refuses every caller.
DETECTOR_TOKEN=
# The detector's old name for the same token, read only when DETECTOR_TOKEN is blank. If both are
# set they must be equal, or the detector refuses to start. Leave it blank.
CALLBACK_API_TOKEN=
# Mock mode only: real_cfo, cloned_voice, replay, ai_agent or human_impostor.
DETECTOR_SCENARIO=

# Twilio Verify, for the SMS code. The detector sends the SMS and checks the code; the agent never
# sees the number or the code. Real mode answers 503 otp_unavailable without all three.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ============================================================== Dashboard

# The review dashboard at GET /review is served by the detector and takes DETECTOR_TOKEN above.

# Supabase. In the spec, the store for sessions, decisions and consent that a live dashboard reads.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
