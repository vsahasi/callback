# Callback detector: copy to .env and fill in. Never commit .env.

# Bearer token the LiveKit agent presents on every request.
CALLBACK_API_TOKEN=replace-me-with-a-long-random-string

# Run the scripted mock detector instead of real models.
CALLBACK_MOCK_MODE=true

# Session lifetime and OTP policy.
CALLBACK_SESSION_TTL_SECONDS=300
CALLBACK_OTP_MAX_ATTEMPTS=3
CALLBACK_OTP_TTL_SECONDS=120

# Mock-only: simulated per-request latency window, milliseconds.
CALLBACK_MOCK_JITTER_MIN_MS=150
CALLBACK_MOCK_JITTER_MAX_MS=400
