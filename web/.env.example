# Base URL of the detector, e.g. http://127.0.0.1:8000. Empty serves fixtures.
DETECTOR_URL=
# The detector's service bearer token (CALLBACK_API_TOKEN). Server-side only.
DETECTOR_TOKEN=
# Set to 1 to force recorded sample data even when DETECTOR_URL is set.
DASHBOARD_FIXTURES=
# Leave empty for the /v1 review API. Set to events for the older /review/api source.
DASHBOARD_SOURCE=
