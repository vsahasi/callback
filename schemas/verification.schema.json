        "VerificationResult": {
          "additionalProperties": false,
          "description": "The details verdict. The operator record that is attached to the bill.\n\nCarries no digit, no position and no length. `match_class` names the shape\nof the discrepancy because the person approving the payment needs it;\n`caller_disclosure` is the only part of this that may be spoken.",
          "properties": {
            "attempts_remaining": {
              "minimum": 0,
              "title": "Attempts Remaining",
              "type": "integer"
            },
            "attempts_used": {
              "minimum": 0,
              "title": "Attempts Used",
              "type": "integer"
            },
            "caller_disclosure": {
