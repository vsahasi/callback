              "description": "True when the attempt cap stopped the comparison.",
              "title": "Rate Limited",
              "type": "boolean"
            },
            "reason": {
              "description": "Operator-facing, digit free.",
              "maxLength": 500,
              "title": "Reason",
              "type": "string"
            },
            "session_id": {
              "title": "Session Id",
              "type": "string"
            },
            "target": {
              "$ref": "#/$defs/VerificationTarget"
