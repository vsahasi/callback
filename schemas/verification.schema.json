  "policy": {
    "disclosure_by_verdict": {
      "mismatch": "not_confirmed",
      "needs_review": "not_confirmed",
      "verified": "confirmed"
    },
    "leak_substring_digits": 4,
    "max_near_miss_edits": 1,
    "max_transcript_chars": 2000,
    "near_miss_classes": [
      "adjacent_transposition",
      "extra_digit",
      "missing_digit",
      "single_digit_substitution"
    ],
    "near_miss_min_digits": 6,
    "redacted_placeholder": "<redacted>",
    "target_digit_rules": {
      "account_number": [
        4,
        20
      ],
      "routing_number": [
        9,
        9
      ],
      "sort_code": [
        6,
        6
      ]
    },
    "verdict_by_match": {
      "adjacent_transposition": "needs_review",
      "exact": "verified",
      "extra_digit": "needs_review",
      "missing_digit": "needs_review",
      "not_compared": "needs_review",
      "single_digit_substitution": "needs_review",
      "unparseable": "needs_review",
      "unrelated": "mismatch"
    }
  },
  "verification_version": "0.1.0-provisional"
