# Line endings and diff behaviour.
#
# This repo is edited from WSL and from Windows. Without a policy, one
# developer's editor rewrites every line of a file the other one touches and
# the diff becomes unreviewable. Everything here is stored and checked out
# with LF, on every platform.

# Default: Git decides what is text, and text is always LF.
* text=auto eol=lf

# Source and config, stated explicitly so nothing depends on heuristics.
*.py    text eol=lf diff=python
*.pyi   text eol=lf diff=python
*.toml  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf

# Recipes must reach make with tab indentation and LF endings or it fails
# with "missing separator".
Makefile        text eol=lf
.gitattributes  text eol=lf
.gitignore      text eol=lf
.env.example    text eol=lf

# uv.lock is machine-written and 100KB of it. Marking it generated collapses
# it in pull requests and keeps it out of the language stats, while leaving
# `git diff` on it readable locally. Never hand-merge a conflict in it: take
# either side and re-run `uv lock`.
uv.lock  text eol=lf linguist-generated=true

# The opposite case. schemas/contract.schema.json is generated by
# `make snapshot`, but it is the frozen contract between the detector and the
# voice agent: its diff is the most important one in any review. Keep it
# expanded and never treated as noise.
schemas/contract.schema.json  text eol=lf -linguist-generated diff

# Call audio and model artefacts. These are gitignored, but if one is ever
# force-added it must not be line-ending mangled or diffed as text.
*.wav           binary
*.mp3           binary
*.flac          binary
*.m4a           binary
*.ogg           binary
*.pt            binary
*.pth           binary
*.ckpt          binary
*.safetensors   binary
*.onnx          binary
